# ==============================================================================
# LibraFlow Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
# cp .env.example .env

# Node Environment & Server Settings
NODE_ENV=development
PORT=5000
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173

# Database Connection (Aiven Cloud MySQL or Local MySQL)
# To use Aiven Cloud MySQL:
# 1. Provide your host, port, user, password, and database name from Aiven console.
# 2. Provide DB_SSL=true and optionally DB_SSL_CA_PATH if Aiven CA certificate is stored locally.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=libraflow_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=15
DB_SSL=false
# Path to downloaded Aiven CA pem certificate file (if DB_SSL=true)
DB_SSL_CA_PATH=

# JWT Secrets for Authentication
# Generate strong, random secrets in production (e.g. using `openssl rand -hex 32`)
JWT_SECRET=libraflow_super_secret_jwt_access_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=libraflow_super_secret_jwt_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional AI Library Assistant (Gemini API)
# Leave blank to run the system in deterministic core mode without AI features
GEMINI_API_KEY=

# Default Library Timezone and Currency
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
